# BossAIGC 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ===== Supabase 配置 =====
# 在 Supabase 控制台 > Settings > API 中获取
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ===== NanoBanana 出图配置 =====
# 在 Ace Data Cloud 获取 API Key
NANOBANANA_API_KEY=

# ===== 认证配置（生产必填）=====
# JWT 密钥：openssl rand -hex 32 生成
JWT_SECRET=
# JWT 过期时间（小时），默认 24
JWT_EXPIRE_HOURS=24
# 老板登录用户名
BOSS_USERNAME=boss
# 老板登录密码哈希，格式 "salt$sha256hash"
# 生成方式：python -c "from boss_aigc.auth import _hash_password; print(_hash_password('你的密码'))"
BOSS_PASSWORD_HASH=

# ===== CORS 配置 =====
# 允许的前端来源，逗号分隔
# 生产应改为你的域名，如 https://boss.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://47.107.160.40,http://xjloveqrj.pw,https://xjloveqrj.pw

# ===== 出图平台配置 =====
# 出图平台：mock（占位图）| modelscope（魔搭免费）| nanobanana（付费）
PLATFORM_PROVIDER=modelscope
# 魔搭 SDK Token：https://modelscope.cn 账号设置页获取
MODELSCOPE_API_KEY=
# 魔搭文生图模型（默认 Qwen/Qwen-Image）
MODELSCOPE_MODEL=Qwen/Qwen-Image
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1

# 兼容旧配置（PLATFORM_PROVIDER=nanobanana 时用）
# True=真实出图，False=Mock（旧开关，现由 PLATFORM_PROVIDER 主导）
USE_REAL_PLATFORM=False
